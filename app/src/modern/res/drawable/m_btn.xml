<?xml version="1.0" encoding="utf-8"?>
<!-- Yuvarlak buton: odakta turuncu dolgu -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFFFA45C" android:endColor="#FFFF7A1A" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFFFB86E" android:endColor="#FFFF7A1A" />
            <stroke android:width="2dp" android:color="#FFFFD9B3" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m_card_hi" />
            <stroke android:width="2dp" android:color="@color/m_accent" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m_card" />
            <stroke android:width="1dp" android:color="@color/m_line" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
