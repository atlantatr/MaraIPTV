<?xml version="1.0" encoding="utf-8"?>
<!-- Buyuk "Canli TV" karti: gorselin altinda kalan koyu taban (clipToOutline icin) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m_card_hi" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m_card_hi" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m_card" />
            <stroke android:width="1dp" android:color="@color/m_line" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
