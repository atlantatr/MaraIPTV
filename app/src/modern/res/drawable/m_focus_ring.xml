<?xml version="1.0" encoding="utf-8"?>
<!-- Gorselin uzerine cizilen odak halkasi (foreground) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FF7A1A" />
            <stroke android:width="3dp" android:color="@color/m_accent" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1AFF7A1A" />
            <stroke android:width="3dp" android:color="@color/m_accent" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/m_line" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
