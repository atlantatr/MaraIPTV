<?xml version="1.0" encoding="utf-8"?>
<!-- Ana ekran karti: odakta turuncu cerceve + aydinlik zemin -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m_card_hi" />
            <stroke android:width="2dp" android:color="@color/m_accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF283349" android:endColor="#FF192233" />
            <stroke android:width="2dp" android:color="@color/m_accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m_card" />
            <stroke android:width="1dp" android:color="@color/m_line" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
