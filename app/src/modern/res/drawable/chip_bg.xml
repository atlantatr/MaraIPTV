<?xml version="1.0" encoding="utf-8"?>
<!-- [Android 5.0 / 7.0] Spor filtresi (lig / takim) kutusu -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m_card_hi" />
            <stroke android:width="2dp" android:color="@color/m_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_window_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#40FF7A1A" android:endColor="#1AFF7A1A" />
            <stroke android:width="2dp" android:color="@color/m_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#22FF7A1A" />
            <stroke android:width="1dp" android:color="@color/m_accent2" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m_card" />
            <stroke android:width="1dp" android:color="@color/m_line" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
