<?xml version="1.0" encoding="utf-8"?>
<!-- [Android 5.0 / 7.0] Film / dizi detay ekrani. ID'ler main ile ayni. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/m_bg">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/m_detail_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="34dp">

        <ImageView
            android:id="@+id/poster"
            android:layout_width="210dp"
            android:layout_height="315dp"
            android:background="@drawable/m_poster_frame"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="26dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/m_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.04"
                android:textColor="@color/m_accent2"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="5"
                android:textColor="@color/m_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/people"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/m_text2"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPlay"
                    style="@style/TvButton"
                    android:text="Oynat" />

                <Button
                    android:id="@+id/btnRestart"
                    style="@style/TvButton"
                    android:text="Baştan Oynat"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnFav"
                    style="@style/TvButton"
                    android:text="Favorilere Ekle" />

                <Button
                    android:id="@+id/btnTrailer"
                    style="@style/TvButton"
                    android:text="Fragman"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/seriesBox"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:visibility="gone">

                <ListView
                    android:id="@+id/seasons"
                    style="@style/TvList"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/m_panel"
                    android:choiceMode="singleChoice"
                    android:nextFocusRight="@+id/episodes"
                    android:padding="6dp" />

                <ListView
                    android:id="@+id/episodes"
                    style="@style/TvList"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/m_panel"
                    android:nextFocusLeft="@+id/seasons"
                    android:padding="6dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="18dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
