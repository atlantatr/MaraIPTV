<?xml version="1.0" encoding="utf-8"?>
<!-- [Android 5.0 / 7.0] Canli TV. ID'ler main ile ayni. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/m_bg"
    android:orientation="horizontal"
    android:padding="18dp">

    <!-- Kategoriler -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="22"
        android:background="@drawable/m_panel"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="2dp">

        <TextView
            style="@style/Header"
            android:text="CANLI TV" />

        <ListView
            android:id="@+id/cats"
            style="@style/TvList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:choiceMode="singleChoice"
            android:nextFocusRight="@+id/channels" />
    </LinearLayout>

    <!-- Kanallar -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_weight="38"
        android:background="@drawable/m_panel"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/catTitle"
            style="@style/Header" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ListView
                android:id="@+id/channels"
                style="@style/TvList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:choiceMode="singleChoice"
                android:nextFocusLeft="@+id/cats" />

            <TextView
                android:id="@+id/msg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="20dp"
                android:textColor="@color/m_text2"
                android:textSize="16sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Onizleme + yayin bilgisi -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="40"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/previewBox"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="#FF04060A">

            <SurfaceView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <ProgressBar
                android:id="@+id/previewLoading"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/previewHint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:text="OK: Önizleme\nTekrar OK: Tam ekran"
                android:textColor="@color/m_text2"
                android:textSize="15sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/m_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/chName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/m_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/m_accent2"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/nowProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_bar"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/nowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/m_text2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/nextList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/m_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="MENU / uzun bas: Favori, Yayın akışı, Kilit"
                android:textColor="@color/m_text2"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
