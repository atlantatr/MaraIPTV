<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo setinden: acilis gorseli (yoksa koyu gradyan) -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_art" />

        <!-- Logo setinden: "Mara IPTV Player" yazi logosu -->
        <ImageView
            android:layout_width="260dp"
            android:layout_height="90dp"
            android:layout_marginTop="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_text" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/webInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.4"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Header"
            android:text="Profiller (Xtream hesaplari)" />

        <ListView
            android:id="@+id/list"
            style="@style/TvList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Henuz profil yok.\n'Yeni Profil' ile Xtream hesabinizi ekleyin."
            android:textColor="@color/text2"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAdd"
                style="@style/TvButton"
                android:text="+ Yeni Profil" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/TvButton"
                android:text="Ayarlar" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ipucu: Profil uzerinde MENU tusu veya uzun basma ile duzenle / sil."
            android:textColor="@color/text2"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
