<?xml version="1.0" encoding="utf-8"?>
<!--
  [Android 5.0 / 7.0] Modern (Material) tema ve stil katmani.
  Bu dosya yalnizca lollipop ve nougat surumlerine eklenir; legacy (4.2)
  Holo tabanli main/res/values/styles.xml kullanmaya devam eder.
  Yerlesimlerdeki ID'ler degismedigi icin Java kodu aynen calisir.
-->
<resources>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/m_bg</item>
        <item name="android:colorBackground">@color/m_bg</item>
        <item name="android:textColor">@color/m_text</item>
        <item name="android:textColorPrimary">@color/m_text</item>
        <item name="android:textColorSecondary">@color/m_text2</item>
        <item name="android:colorAccent">@color/m_accent</item>
        <item name="android:colorPrimary">@color/m_bg</item>
        <item name="android:colorPrimaryDark">@color/m_bg</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="PlayerTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="SettingsTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/m_bg</item>
        <item name="android:colorBackground">@color/m_bg</item>
        <item name="android:listDivider">@android:color/transparent</item>
        <item name="android:dividerHeight">6dp</item>
    </style>

    <!-- Yuvarlak, dolgulu buton -->
    <style name="TvButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/m_btn</item>
        <item name="android:textColor">@color/m_btn_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Bolum / kategori basligi -->
    <style name="Header">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/m_accent2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TvList">
        <item name="android:listSelector">@drawable/m_row_selector</item>
        <item name="android:drawSelectorOnTop">true</item>
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:cacheColorHint">@android:color/transparent</item>
        <item name="android:scrollbarStyle">outsideOverlay</item>
        <item name="android:fadingEdge">none</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">7dp</item>
        <item name="android:background">@drawable/m_card</item>
        <item name="android:textColor">@color/m_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="EpgDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/m_text2</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="EpgBlock">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:background">@drawable/m_epg_block</item>
        <item name="android:textColor">@color/m_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- modern yerlesimler icin yardimci stiller -->

    <style name="MCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/m_text</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="MCardSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/m_text2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="MCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/m_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>

    <style name="MChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/m_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
    </style>

</resources>
