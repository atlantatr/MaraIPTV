<?xml version="1.0" encoding="utf-8"?>
<!-- Film ve dizi detay ekrani (dizi icin sezon/bolum listesi de var) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="28dp">

        <ImageView
            android:id="@+id/poster"
            android:layout_width="200dp"
            android:layout_height="300dp"
            android:background="@color/panel2"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="24dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="5"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/people"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button android:id="@+id/btnPlay" style="@style/TvButton" android:text="Oynat" />
                <Button android:id="@+id/btnRestart" style="@style/TvButton" android:text="Bastan Oynat" android:visibility="gone" />
                <Button android:id="@+id/btnFav" style="@style/TvButton" android:text="Favorilere Ekle" />
                <Button android:id="@+id/btnTrailer" style="@style/TvButton" android:text="Fragman" android:visibility="gone" />
            </LinearLayout>

            <!-- Diziler icin -->
            <LinearLayout
                android:id="@+id/seriesBox"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:visibility="gone">

                <ListView
                    android:id="@+id/seasons"
                    style="@style/TvList"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/panel_bg"
                    android:choiceMode="singleChoice"
                    android:nextFocusRight="@+id/episodes"
                    android:padding="4dp" />

                <ListView
                    android:id="@+id/episodes"
                    style="@style/TvList"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/panel_bg"
                    android:nextFocusLeft="@+id/seasons"
                    android:padding="4dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
