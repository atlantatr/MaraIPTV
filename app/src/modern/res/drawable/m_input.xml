<?xml version="1.0" encoding="utf-8"?>
<!-- Arama kutusu -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF121926" />
            <stroke android:width="2dp" android:color="@color/m_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF10151F" />
            <stroke android:width="1dp" android:color="@color/m_line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
