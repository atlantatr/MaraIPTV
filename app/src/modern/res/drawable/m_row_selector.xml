<?xml version="1.0" encoding="utf-8"?>
<!-- Liste secim/odak kutusu (kategori, kanal, bolum satirlari) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FF7A1A" />
            <stroke android:width="2dp" android:color="@color/m_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_window_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#40FF7A1A" android:endColor="#1AFF7A1A" />
            <stroke android:width="2dp" android:color="@color/m_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
