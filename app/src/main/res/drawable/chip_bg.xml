<?xml version="1.0" encoding="utf-8"?>
<!-- [Android 4.2] Spor filtresi (lig / takim) kutusu -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#44FF7A1A" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_window_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FF7A1A" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FF7A1A" />
            <stroke android:width="1dp" android:color="@color/accent_dim" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel2" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
